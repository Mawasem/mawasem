{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MawasemECommerceDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "Mawasem.API",
    "Audience": "Mawasem.React",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "CustomerPasswordReset": {
    "CodeLength": 6,
    "CodeLifetimeMinutes": 10,
    "ResetTokenLifetimeMinutes": 10,
    "MaxFailedAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "Frontend": {
    "AllowedOrigins": []
  },
  "Security": {
    "GeneralRequestsPerMinute": 120,
    "AuthenticationRequestsPerMinute": 10,
    "SensitiveRequestsPerMinute": 30,
    "MaximumRequestBodySizeBytes": 10485760
  },
  "ProductImageStorage": {
    "AzureBlob": {
      "ServiceUri": "",
      "ContainerName": "product-images",
      "PublicBaseUrl": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}